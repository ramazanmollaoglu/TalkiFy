<Window x:Class="TranslatorViewer.AudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TranslatorViewer"
        mc:Ignorable="d"  Loaded="Window_Loaded"
        Title="AudioWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="debugBox"/>
        <Grid Grid.Column="1" x:Name="PropertiesGrid">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Width="80">Baud Rate : </Label>
                    <ComboBox x:Name="BaudRateBox" Width="200" SelectionChanged="ComboBox_SelectionChanged"></ComboBox>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Width="80">Input Index</Label>
                        <TextBox x:Name="InputBox" Width="200"></TextBox>
                        <Label Width="80">Output Index</Label>
                        <TextBox x:Name="OutputBox" Width="170"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Width="80">Channel</Label>
                        <TextBox x:Name="ChannelBox" Width="200"></TextBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <Button Height="20" HorizontalAlignment="Center" Width="200" Click="Button_Click">Start
                        
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
